{
  "openapi": "3.1.0",
  "info": {
    "title": "AstraNull GuardianBot DAST surface",
    "version": "1.0.0",
    "description": "Generated, non-destructive API surface for authenticated GuardianBot staging scans."
  },
  "servers": [
    {
      "url": "https://guardianbot-astranull-stage-sisf9.ondigitalocean.app"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check process health",
        "responses": {
          "200": {
            "description": "The process is healthy."
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check service readiness",
        "responses": {
          "200": {
            "description": "The service and required dependencies are ready."
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "operationId": "getAuthenticatedState",
        "summary": "Read the authenticated staging state",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated state returned."
          },
          "401": {
            "description": "Authentication is missing or invalid."
          },
          "403": {
            "description": "The authenticated principal is not authorized."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
