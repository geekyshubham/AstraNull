# Railway hosted-staging (customer production-like). Link Postgres first.
NODE_ENV=production
PORT=3000

ASTRANULL_DATABASE_URL=${{Postgres.DATABASE_URL}}
ASTRANULL_PERSISTENCE_MODE=postgres
ASTRANULL_DEPLOYMENT_PROFILE=hosted-staging

# Bundled staging OIDC fixture (HTTPS JWKS served from /.well-known/jwks.json)
ASTRANULL_BUNDLED_STAGING_OIDC=1
ASTRANULL_AUTH_MODE=oidc-jwt
# REQUIRED whenever NODE_ENV=production and auth is oidc-jwt. Production resolves roles ONLY
# through this map; with it unset every token is rejected (invalid_role) and all login breaks.
# Identity mapping because the bundled fixture emits platform role names directly. A real IdP
# maps its own group names here instead, e.g. `AstraNull-Admins:admin`.
#
# Do NOT add ASTRANULL_OIDC_STAFF_ROLE_MAP. Leaving it unset is what stops a `staff_role` token
# claim from resolving to platform staff authority; staff roles must come from a real IdP.
ASTRANULL_OIDC_ROLE_MAP=owner:owner,admin:admin,engineer:engineer,soc:soc,auditor:auditor,viewer:viewer
# REQUIRED — the token-signing keypair. ops/staging/bundled-oidc-fixture.json is gitignored
# and excluded from images because it is the auth trust root (an earlier version was committed
# to this public repo and is now refused at startup by fingerprint). Startup fails closed
# without this. Generate with: npm run oidc:fixture:generate -- --force
# then paste the file contents here as a single-line JSON value.
ASTRANULL_BUNDLED_STAGING_OIDC_FIXTURE_JSON=<paste ops/staging/bundled-oidc-fixture.json>
ASTRANULL_OIDC_AUDIENCE=astranull-hosted-staging
# Issuer/JWKS default from RAILWAY_PUBLIC_DOMAIN when unset
ASTRANULL_PUBLIC_LOGIN_URL=/login

# Production-like safe paths (no dry-run high-scale adapter, signed probe worker)
ASTRANULL_PROBE_MODE=signed-worker
ASTRANULL_PROBE_WORKER_SECRET=<generate: openssl rand -hex 24>
ASTRANULL_PROBE_TENANT_ID=ten_demo
ASTRANULL_HIGH_SCALE_ADAPTER_MODE=disabled
ASTRANULL_AGENT_IDENTITY_MODE=bearer

# Generate per environment; never reuse a value that has appeared in git history.
ASTRANULL_SECRET_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
ASTRANULL_WAF_POSTURE_ENABLED=1
ASTRANULL_CONNECTORS_ENABLED=0