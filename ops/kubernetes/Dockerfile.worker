# AstraNull scheduled worker image (operator CLIs under scripts/).
# Base image pinned by digest for reproducible builds. Dependabot keeps this current
# (see .github/dependabot.yml); do not replace with a floating tag.
FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80

LABEL org.opencontainers.image.title="AstraNull Worker"
LABEL org.opencontainers.image.description="Scheduled operator runners for Postgres-backed AstraNull control plane"
LABEL org.opencontainers.image.vendor="AstraNull"

RUN addgroup -g 10001 -S astranull \
  && adduser -u 10001 -S astranull -G astranull

WORKDIR /app

# Runtime dependencies must be installed: every scheduled runner reaches `pg` through
# src/persistence/postgres/pool.mjs, so a dependency-free image fails at import with
# ERR_MODULE_NOT_FOUND before doing any work. The lockfile is copied without a glob so
# a missing lockfile breaks the build instead of silently floating.
COPY package.json package-lock.json ./
# npm is removed after install; nothing at runtime invokes npm/npx/yarn.
RUN npm ci --omit=dev && npm cache clean --force \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY src ./src
COPY scripts ./scripts
COPY db/schema.sql ./db/schema.sql
COPY db/migrations ./db/migrations

USER astranull

ENV NODE_ENV=production