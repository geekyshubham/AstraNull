# Runtime env for the AWS VM. Copy to ops/aws/.env on the instance — never commit .env.
# Generate secrets with:
#   openssl rand -hex 32   # POSTGRES_PASSWORD, ASTRANULL_DATABASE_APP_PASSWORD,
#                           ASTRANULL_DATABASE_BACKUP_PASSWORD,
#                           ASTRANULL_BACKUP_ENCRYPTION_KEY, and ASTRANULL_SECRET_ENCRYPTION_KEY
#   openssl rand -hex 24   # ASTRANULL_PROBE_WORKER_SECRET
# OIDC fixture: npm run oidc:fixture:generate  then paste the JSON as one line.

NODE_ENV=production
PORT=8080

POSTGRES_PASSWORD=<generate: openssl rand -hex 32>
ASTRANULL_DATABASE_APP_PASSWORD=<generate: openssl rand -hex 32>
ASTRANULL_DATABASE_BACKUP_PASSWORD=<generate: openssl rand -hex 32>

ASTRANULL_PUBLIC_BASE_URL=https://astranull.site
ASTRANULL_PERSISTENCE_MODE=postgres
ASTRANULL_DEPLOYMENT_PROFILE=hosted-staging
ASTRANULL_BUNDLED_STAGING_OIDC=1
ASTRANULL_AUTH_MODE=oidc-jwt
ASTRANULL_OIDC_ISSUER=https://astranull.site
ASTRANULL_OIDC_AUDIENCE=astranull-hosted-staging
ASTRANULL_OIDC_JWKS_URL=https://astranull.site/.well-known/jwks.json
ASTRANULL_OIDC_ROLE_MAP=owner:owner,admin:admin,engineer:engineer,soc:soc,auditor:auditor,viewer:viewer
ASTRANULL_PUBLIC_LOGIN_URL=/login
ASTRANULL_PROBE_MODE=signed-worker
ASTRANULL_PROBE_TENANT_ID=ten_demo
ASTRANULL_PROBE_WORKER_ID=aws-probe-worker
ASTRANULL_PROBE_POLL_INTERVAL_MS=5000
ASTRANULL_HIGH_SCALE_ADAPTER_MODE=disabled
ASTRANULL_AGENT_IDENTITY_MODE=bearer
ASTRANULL_WAF_POSTURE_ENABLED=1
ASTRANULL_CONNECTORS_ENABLED=0

# Do not set ASTRANULL_OIDC_STAFF_ROLE_MAP. Staff roles must come from a real IdP.

# Generate distinct backup DB and encryption credentials. Deployment validation rejects
# any reuse among owner DB, app DB, backup DB, backup encryption, and envelope encryption.
ASTRANULL_BACKUP_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
ASTRANULL_SECRET_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
ASTRANULL_PROBE_WORKER_SECRET=<generate: openssl rand -hex 24>
ASTRANULL_BUNDLED_STAGING_OIDC_FIXTURE_JSON=<paste ops/staging/bundled-oidc-fixture.json as one line>


# Password recovery delivery worker (always on; non-secret settings).
# Keep every served tenant in this explicit comma-separated scope; the worker never enumerates tenants across RLS.
ASTRANULL_PASSWORD_RECOVERY_TENANT_IDS=ten_demo
# Leave blank for queue-only provider-unconfigured mode: attempts stay nondelivered and retryable.
# Set a real SMTP host to enable delivery; configure the sender and optional AUTH below.
ASTRANULL_SMTP_HOST=
ASTRANULL_SMTP_PORT=587
ASTRANULL_SMTP_STARTTLS=true
ASTRANULL_SMTP_FROM=noreply@astranull.site
# Optional SMTP AUTH PLAIN credentials. Supply the password through the deployment secret manager.
ASTRANULL_SMTP_USERNAME=
ASTRANULL_SMTP_PASSWORD=
ASTRANULL_PASSWORD_RECOVERY_INTERVAL_MS=5000
ASTRANULL_PASSWORD_RECOVERY_LEASE_MS=30000
ASTRANULL_PASSWORD_RECOVERY_MAX_ATTEMPTS=5
ASTRANULL_PASSWORD_RECOVERY_RETRY_BASE_MS=60000
ASTRANULL_PASSWORD_RECOVERY_RETRY_MAX_MS=3600000

# Explicit scheduler tenant scope; comma-separated safe tenant IDs.
ASTRANULL_TEST_POLICY_TENANT_IDS=ten_demo
ASTRANULL_TEST_POLICY_RUNNER_ID=aws-policy-runner
ASTRANULL_TEST_POLICY_LEASE_MS=60000
# Integer seconds only; valid range 5-30. The 120s tick bound plus the 30s cap
# stays 30s inside the policy worker's 180s heartbeat freshness window.
ASTRANULL_TEST_POLICY_INTERVAL_SECONDS=30
