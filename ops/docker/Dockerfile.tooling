# Operator tooling image for local staging migrate/seed jobs.
# Base image pinned by digest for reproducible builds. Dependabot keeps this current
# (see .github/dependabot.yml); do not replace with a floating tag.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app

# Lockfile copied without a glob: a missing lockfile must fail the build rather
# than fall back to an unpinned install.
COPY package.json package-lock.json ./
# npm is removed after install; the migrate/seed jobs only run node.
RUN npm ci --omit=dev && npm cache clean --force \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY src ./src
COPY scripts ./scripts
COPY db/migrations ./db/migrations
COPY db/schema.sql ./db/schema.sql
COPY tests/fixtures ./tests/fixtures

# The migrate/seed jobs only read the image and talk to Postgres; run them unprivileged.
USER node

CMD ["node", "scripts/local-staging-migrate.mjs"]