# Operator tooling image for local staging migrate/seed jobs.
# Base image pinned by digest for reproducible builds. Dependabot keeps this current
# (see .github/dependabot.yml); do not replace with a floating tag.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

WORKDIR /app

# Lockfile copied without a glob: a missing lockfile must fail the build rather
# than fall back to an unpinned install.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY src ./src
COPY scripts ./scripts
COPY db/migrations ./db/migrations
COPY db/schema.sql ./db/schema.sql
COPY tests/fixtures ./tests/fixtures

CMD ["node", "scripts/local-staging-migrate.mjs"]