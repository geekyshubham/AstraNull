# Local Docker staging simulator.
#
# Secrets below are placeholders, NOT usable values. Before the first
# `npm run staging:local:up`, fill each one in with a locally generated value:
#   openssl rand -hex 32   # ASTRANULL_SECRET_ENCRYPTION_KEY
#   openssl rand -hex 32   # ASTRANULL_SESSION_SECRET
#   openssl rand -hex 24   # ASTRANULL_PROBE_WORKER_SECRET
# Keep generated values out of git. The previous committed values were published
# in a public repository and are permanently compromised; startup now rejects them.
NODE_ENV=development
PORT=3000

ASTRANULL_PERSISTENCE_MODE=postgres
ASTRANULL_AUTH_MODE=dev-headers
ASTRANULL_PROBE_MODE=signed-worker
ASTRANULL_HIGH_SCALE_ADAPTER_MODE=dry-run
ASTRANULL_AGENT_IDENTITY_MODE=bearer
ASTRANULL_WAF_POSTURE_ENABLED=1
ASTRANULL_CONNECTORS_ENABLED=0

ASTRANULL_SECRET_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
ASTRANULL_SESSION_SECRET=<generate: openssl rand -hex 32>
ASTRANULL_PROBE_WORKER_SECRET=<generate: openssl rand -hex 24>

ASTRANULL_LOCAL_PG_PORT=54329
ASTRANULL_LOCAL_STAGING_BASE_URL=http://127.0.0.1:3000
ASTRANULL_LOCAL_STAGING_ENVIRONMENT=local-staging
ASTRANULL_LOCAL_STAGING_RELEASE_ID=rel-local-staging-2026-07-03