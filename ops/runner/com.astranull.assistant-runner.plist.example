<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.astranull.assistant-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a; . "$HOME/.config/astranull/assistant-runner.env"; set +a; exec /opt/homebrew/opt/node@26/bin/node workers/assistant-runner.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/astranull</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/path/to/logs/assistant-runner.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/logs/assistant-runner.log</string>
</dict>
</plist>
